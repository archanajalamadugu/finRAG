# Copy this file to ".env" and paste your real keys in.
#
#     cp .env.example .env
#
# .env is listed in .gitignore, so it never reaches GitHub.
# .env.example has no secrets in it, so it is safe to commit --
# it tells anyone else what keys the project needs.

# From https://tokenfactory.nebius.com/project/api-keys
NEBIUS_API_KEY=paste-your-nebius-key-here

# From https://app.pinecone.io  ->  API Keys
PINECONE_API_KEY=paste-your-pinecone-key-here
